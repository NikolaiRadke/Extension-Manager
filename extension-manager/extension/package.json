{
  "name": "extension-manager",
  "displayName": "Extension Manager",
  "description": "Manage installed extensions in Arduino IDE 2.x",
  "version": "2.0.1",
  "publisher": "MonsterMaker",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "arduino",
    "arduinoIDE",
    "extension",
    "manager",
    "plugin"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Extension Manager",
      "properties": {
        "extensionManager.checkUpdatesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.checkUpdatesOnStartup%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensionManager",
          "title": "Extension Manager",
          "icon": "resources/extensions.svg"
        }
      ]
    },
    "views": {
      "extensionManager": [
        {
          "type": "webview",
          "id": "extensionManager.extensionTree",
          "name": "%view.installed%"
        }
      ]
    },
    "commands": [
      {
        "command": "extensionManager.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "extensionManager.enable",
        "title": "%command.enable%",
        "icon": "$(check)"
      },
      {
        "command": "extensionManager.disable",
        "title": "%command.disable%",
        "icon": "$(close)"
      },
      {
        "command": "extensionManager.uninstall",
        "title": "%command.uninstall%",
        "icon": "$(trash)"
      },
      {
        "command": "extensionManager.showInfo",
        "title": "%command.showInfo%",
        "icon": "$(info)"
      },
      {
        "command": "extensionManager.install",
        "title": "%command.install%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "extensionManager.checkUpdates",
        "title": "%command.checkUpdates%",
        "icon": "$(sync)"
      },
      {
        "command": "extensionManager.update",
        "title": "%command.update%"
      },
      {
        "command": "extensionManager.about",
        "title": "%command.about%",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extensionManager.update",
          "when": "false"
        },
        {
          "command": "extensionManager.refresh",
          "when": "false"
        },
        {
          "command": "extensionManager.enable",
          "when": "false"
        },
        {
          "command": "extensionManager.disable",
          "when": "false"
        },
        {
          "command": "extensionManager.uninstall",
          "when": "false"
        },
        {
          "command": "extensionManager.showInfo",
          "when": "false"
        },
        {
          "command": "extensionManager.install",
          "when": "false"
        },
        {
          "command": "extensionManager.about",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "extensionManager.checkUpdates",
          "when": "view == extensionManager.extensionTree",
          "group": "navigation"
        },
        {
          "command": "extensionManager.refresh",
          "when": "view == extensionManager.extensionTree",
          "group": "navigation"
        },
        {
          "command": "extensionManager.install",
          "when": "view == extensionManager.extensionTree",
          "group": "navigation"
        },
        {
          "command": "extensionManager.about",
          "when": "view == extensionManager.extensionTree",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'No compilation needed'",
    "package": "vsce package"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikolaiRadke/Extension-Manager"
  }
}
