{
  "name": "extension-manager",
  "displayName": "Extension Manager",
  "description": "Manage installed extensions in Arduino IDE 2.x",
  "version": "1.1.0",
  "publisher": "MonsterMaker",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "arduino",
    "arduinoIDE",
    "extension",
    "manager",
    "plugin"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensionManager",
          "title": "Extension Manager",
          "icon": "resources/extensions.svg"
        }
      ]
    },
    "views": {
      "extensionManager": [
        {
          "id": "extensionManager.extensionTree",
          "name": "%view.installed%"
        }
      ]
    },
    "commands": [
      {
        "command": "extensionManager.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "extensionManager.enable",
        "title": "%command.enable%",
        "icon": "$(check)"
      },
      {
        "command": "extensionManager.disable",
        "title": "%command.disable%",
        "icon": "$(close)"
      },
      {
        "command": "extensionManager.uninstall",
        "title": "%command.uninstall%",
        "icon": "$(trash)"
      },
      {
        "command": "extensionManager.showInfo",
        "title": "%command.showInfo%",
        "icon": "$(info)"
      },
      {
        "command": "extensionManager.install",
        "title": "%command.install%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "extensionManager.about",
        "title": "%command.about%",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extensionManager.refresh",
          "when": "false"
        },
        {
          "command": "extensionManager.enable",
          "when": "false"
        },
        {
          "command": "extensionManager.disable",
          "when": "false"
        },
        {
          "command": "extensionManager.uninstall",
          "when": "false"
        },
        {
          "command": "extensionManager.showInfo",
          "when": "false"
        },
        {
          "command": "extensionManager.install",
          "when": "false"
        },
        {
          "command": "extensionManager.about",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "extensionManager.refresh",
          "when": "view == extensionManager.extensionTree",
          "group": "navigation"
        },
        {
          "command": "extensionManager.install",
          "when": "view == extensionManager.extensionTree",
          "group": "navigation"
        },
        {
          "command": "extensionManager.about",
          "when": "view == extensionManager.extensionTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "extensionManager.showInfo",
          "when": "view == extensionManager.extensionTree && viewItem =~ /^extension/",
          "group": "inline@1"
        },
        {
          "command": "extensionManager.enable",
          "when": "view == extensionManager.extensionTree && viewItem == extension-disabled",
          "group": "inline@2"
        },
        {
          "command": "extensionManager.disable",
          "when": "view == extensionManager.extensionTree && viewItem == extension-enabled",
          "group": "inline@2"
        },
        {
          "command": "extensionManager.uninstall",
          "when": "view == extensionManager.extensionTree && viewItem =~ /extension/ && viewItem != extension-self",
          "group": "inline@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'No compilation needed'",
    "package": "vsce package"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikolaiRadke/Extension-Manager"
  }
}
